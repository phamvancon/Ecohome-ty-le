                console.error("Firebase auth error:", err);
                updateSyncBadge(false, "Lỗi kết nối Firebase");
            }
        }

        function updateSyncBadge(isOnline, text) {
            const badge = document.getElementById('sync-status-badge');
            if (!badge) return;
            if (isOnline) {
                badge.innerHTML = `<i class="fa-solid fa-cloud text-emerald-300 mr-1"></i>${text}`;
                badge.className = "text-xs text-emerald-200/90 font-medium";
