                badge.innerHTML = `<i class="fa-solid fa-cloud-slash text-rose-300 mr-1"></i>${text}`;
                badge.className = "text-xs text-rose-200/90 font-medium";
            }
        }

        function setupRealtimeListeners() {
            // Realtime Listener for Apartments List
            onSnapshot(apartmentsColRef, (snapshot) => {
                const loadedList = [];
                snapshot.forEach((docSnap) => {
                    const data = docSnap.data();
                    loadedList.push({
                        id: docSnap.id,
                        area: typeof data.area === 'number' ? data.area : parseFloat(data.area) || 0,
                        attended: !!data.attended
                    });
                });

                // Auto initialize sample data on empty cloud DB
                if (loadedList.length === 0 && !state.isInitialLoadDone) {
                    state.isInitialLoadDone = true;
                    loadSampleDataset(false);
                    return;
                }

                state.isInitialLoadDone = true;
                // Sort by apartment ID naturally
                loadedList.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true, sensitivity: 'base' }));
                state.apartments = loadedList;
                render();
            }, (error) => {
                console.error("Apartments Realtime listener error:", error);
                showToast("Lỗi đồng bộ dữ liệu căn hộ từ Cloud!", "error");
            });

            // Realtime Listener for Global Settings
            onSnapshot(settingsDocRef, (docSnap) => {
                if (docSnap.exists()) {
                    const data = docSnap.data();
                    if (data && typeof data.totalAreaOverride === 'number' && data.totalAreaOverride > 0) {
                        state.totalAreaOverride = data.totalAreaOverride;
                        render();
                    }
                }
            }, (error) => {
                console.error("Settings Realtime listener error:", error);
            });
        }

        function render() {
            const effectiveTotalArea = state.totalAreaOverride > 0 ? state.totalAreaOverride : DEFAULT_TOTAL_AREA;
            
            let attendedArea = 0;
            let attendedUnits = 0;

            state.apartments.forEach(apt => {
                if (apt.attended) {
                    attendedArea += apt.area;
                    attendedUnits++;
                }
            });

            const totalUnits = state.apartments.length;
            const percentArea = effectiveTotalArea > 0 ? (attendedArea / effectiveTotalArea) * 100 : 0;
            const percentUnits = totalUnits > 0 ? (attendedUnits / totalUnits) * 100 : 0;
            const missingArea = Math.max(0, effectiveTotalArea - attendedArea);

            document.getElementById('metric-total-area').innerText = formatNumber(effectiveTotalArea);
            document.getElementById('metric-attended-area').innerText = formatNumber(attendedArea);
            document.getElementById('metric-missing-area').innerText = `${formatNumber(missingArea)} m²`;
            document.getElementById('metric-total-units').innerText = totalUnits;
            document.getElementById('metric-attended-units').innerText = attendedUnits;
            document.getElementById('metric-units-percent').innerText = `${percentUnits.toFixed(1)}%`;
            document.getElementById('metric-percent').innerText = `${percentArea.toFixed(2)}%`;

            const barFill = document.getElementById('progress-bar-fill');
            barFill.style.width = `${Math.min(percentArea, 100)}%`;

            const statusBadge = document.getElementById('status-badge');
            if (percentArea >= 50) {
                statusBadge.className = "px-3 py-1 text-xs font-bold rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center gap-1.5 animate-bounce";
                statusBadge.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600"></i> ĐÃ ĐỦ ĐIỀU KIỆN 50% PHÁP LÝ`;

                if (!state.hasFiredConfetti) {
                    triggerCelebrationConfetti();
                    state.hasFiredConfetti = true;
                }
            } else {
                statusBadge.className = "px-3 py-1 text-xs font-bold rounded-full bg-amber-100 text-amber-800 border border-amber-300 flex items-center gap-1.5";
                statusBadge.innerHTML = `<i class="fa-solid fa-hourglass-half"></i> Chưa đạt 50%`;
                state.hasFiredConfetti = false;
            }

            renderTable();
            if (state.isAdminAuthenticated) {
                renderAdminTable();
            }
        }

        function renderTable() {
            const tbody = document.getElementById('apartment-table-body');
            const searchVal = document.getElementById('search-input').value.trim().toLowerCase();
            const filterStatus = document.getElementById('filter-status').value;

            const effectiveTotalArea = state.totalAreaOverride > 0 ? state.totalAreaOverride : DEFAULT_TOTAL_AREA;

            const filtered = state.apartments.filter(apt => {
                const matchesSearch = apt.id.toLowerCase().includes(searchVal);
                let matchesStatus = true;
                if (filterStatus === 'attended') matchesStatus = apt.attended;
                if (filterStatus === 'absent') matchesStatus = !apt.attended;
                return matchesSearch && matchesStatus;
            });

            document.getElementById('table-count-info').innerText = `Hiển thị ${filtered.length} / ${state.apartments.length} căn hộ`;

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-8 text-slate-400 font-medium">
                            Không tìm thấy căn hộ phù hợp với bộ lọc
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = filtered.map((apt, index) => {
                const contribPercent = effectiveTotalArea > 0 ? (apt.area / effectiveTotalArea) * 100 : 0;
                const blockInfo = apt.id.includes('-') ? `Tòa ${apt.id.split('-')[0]}` : 'Ecohome';

                return `
                    <tr class="hover:bg-slate-50 transition border-b border-slate-100">
                        <td class="py-2.5 px-4 font-mono text-slate-400">${index + 1}</td>
                        <td class="py-2.5 px-4 font-bold text-slate-800">${apt.id}</td>
                        <td class="py-2.5 px-4 text-slate-500">${blockInfo}</td>
                        <td class="py-2.5 px-4 text-right font-semibold text-slate-700">${formatNumber(apt.area)}</td>
                        <td class="py-2.5 px-4 text-right font-mono text-slate-500">${contribPercent.toFixed(3)}%</td>
                        <td class="py-2.5 px-4 text-center">
                            ${apt.attended 
                                ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800"><i class="fa-solid fa-check"></i> Đã tham dự</span>`
                                : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-500">Chưa tham dự</span>`
                            }
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function saveBatchApartmentsToCloud(apartmentList, clearExisting = false) {
            if (!auth.currentUser) return;
            try {
                if (clearExisting) {
                    await clearAllFirestoreApartments();
                }

                // Batch writes in chunks of 400 docs (Firestore limit is 500)
                const chunkSize = 400;
                for (let i = 0; i < apartmentList.length; i += chunkSize) {
                    const chunk = apartmentList.slice(i, i + chunkSize);
                    const batch = writeBatch(db);
                    
                    chunk.forEach(apt => {
                        const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'apartments', apt.id);
                        batch.set(docRef, {
                            area: apt.area,
                            attended: apt.attended
                        }, { merge: true });
                    });

                    await batch.commit();
                }
                showToast("Đã đồng bộ lên Firebase Cloud thành công!", "success");
            } catch (e) {
                console.error("Batch save error:", e);
                showToast("Lỗi khi lưu dữ liệu lên Cloud!", "error");
            }
        }

        async function clearAllFirestoreApartments() {
            if (!auth.currentUser) return;
            try {
                const snapshot = await getDocs(apartmentsColRef);
                const docs = snapshot.docs;
                const chunkSize = 400;
                
                for (let i = 0; i < docs.length; i += chunkSize) {
                    const chunk = docs.slice(i, i + chunkSize);
                    const batch = writeBatch(db);
                    chunk.forEach(d => batch.delete(d.ref));
                    await batch.commit();
                }
            } catch (err) {
                console.error("Clear all firestore error:", err);
            }
        }

        function triggerCelebrationConfetti() {
