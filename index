        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];
                    const json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                    processParsedSheetData(json);
                } catch (err) {
                    console.error(err);
                    showToast("Lỗi khi đọc file Excel. Vui lòng kiểm tra định dạng!", "error");
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function processParsedSheetData(rows) {
            if (!rows || rows.length < 2) {
                showToast("File không chứa đủ dữ liệu!", "error");
                return;
            }

            const headers = rows[0].map(h => String(h).toLowerCase().trim());
            let codeColIdx = headers.findIndex(h => h.includes('mã') || h.includes('căn') || h.includes('code') || h.includes('apartment'));
            let areaColIdx = headers.findIndex(h => h.includes('diện tích') || h.includes('area') || h.includes('m2') || h.includes('m²'));

            if (codeColIdx === -1) codeColIdx = 0;
            if (areaColIdx === -1) areaColIdx = 1;

            let importedList = [];
            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                if (!row || !row[codeColIdx]) continue;

                const code = String(row[codeColIdx]).trim().toUpperCase();
                const area = parseFloat(String(row[areaColIdx]).replace(',', '.').trim()) || 0;

                if (code && area > 0) {
                    importedList.push({ id: code, area: area, attended: false });
                }
            }

            if (importedList.length > 0) {
                saveBatchApartmentsToCloud(importedList, true);
                switchAdminTab('manage');
            } else {
                showToast("Không tìm thấy dữ liệu căn hộ hợp lệ trong file!", "error");
            }
        }

        function handlePasteImport() {
            const rawText = document.getElementById('paste-import-input').value.trim();
            if (!rawText) return;

            const lines = rawText.split('\n');
            let newApartments = [];

            lines.forEach(line => {
                if (!line.trim()) return;
                const parts = line.split(/[,|\t]+/);
                if (parts.length >= 2) {
                    const code = parts[0].trim().toUpperCase();
                    const area = parseFloat(parts[1].replace(',', '.').trim());
                    if (code && !isNaN(area) && area > 0) {
                        newApartments.push({ id: code, area: area, attended: false });
                    }
                }
            });

            if (newApartments.length > 0) {
                saveBatchApartmentsToCloud(newApartments, true);
                document.getElementById('paste-import-input').value = '';
                switchAdminTab('manage');
            } else {
                showToast("Định dạng dữ liệu không đúng. Vui lòng kiểm tra lại!", "error");
            }
        }

        async function executeQuickAttendance(statusBool) {
            const raw = document.getElementById('quick-check-input').value.trim();
            if (!raw) return;

            const codes = raw.split(/[\s,\n]+/).map(c => c.trim().toUpperCase()).filter(Boolean);
            if (codes.length === 0) return;

            const batch = writeBatch(db);
            let updateCount = 0;

            state.apartments.forEach(apt => {
                if (codes.includes(apt.id.toUpperCase())) {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'apartments', apt.id);
                    batch.update(docRef, { attended: statusBool });
                    updateCount++;
                }
            });

            if (updateCount > 0) {
                await batch.commit();
                showToast(`Đã cập nhật trạng thái Cloud cho ${updateCount} căn hộ!`, "success");
                document.getElementById('quick-check-input').value = '';
            } else {
                showToast("Không tìm thấy mã căn hộ tương ứng!", "error");
            }
        }

        function renderAdminTable() {
            const tbody = document.getElementById('admin-table-body');
            if (state.apartments.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400">Chưa có dữ liệu căn hộ nào</td></tr>`;
                return;
            }

            tbody.innerHTML = state.apartments.map((apt) => `
                <tr class="hover:bg-slate-50">
                    <td class="p-2.5 font-bold text-slate-800">${apt.id}</td>
                    <td class="p-2.5 font-mono">${formatNumber(apt.area)}</td>
                    <td class="p-2.5 text-center">
                        <label class="inline-flex items-center cursor-pointer">
                            <input type="checkbox" ${apt.attended ? 'checked' : ''} onchange="toggleAttendance('${apt.id}')" class="sr-only peer">
                            <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600 relative"></div>
                        </label>
                    </td>
                    <td class="p-2.5 text-right">
                        <button onclick="deleteApartment('${apt.id}')" class="text-rose-500 hover:text-rose-700 px-2 py-1">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        async function toggleAttendance(code) {
            const target = state.apartments.find(a => a.id === code);
            if (target && auth.currentUser) {
                const newStatus = !target.attended;
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'apartments', code);
                await updateDoc(docRef, { attended: newStatus });
            }
        }

        async function deleteApartment(code) {
            if (!auth.currentUser) return;
            const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'apartments', code);
            await deleteDoc(docRef);
            showToast(`Đã xóa căn hộ ${code} khỏi Cloud`, "info");
        }

        function requestClearAllData() {
            const confirmModal = document.getElementById('confirm-modal');
            confirmModal.firstElementChild.classList.remove('scale-95');
            confirmModal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeConfirmModal() {
            const confirmModal = document.getElementById('confirm-modal');
            confirmModal.firstElementChild.classList.add('scale-95');
            confirmModal.classList.add('opacity-0', 'pointer-events-none');
        }

        async function executeClearAllData() {
            closeConfirmModal();
            await clearAllFirestoreApartments();
            showToast("Đã xóa toàn bộ dữ liệu trên Cloud!", "info");
        }

        async function saveTotalAreaOverride() {
            const inputVal = parseFloat(document.getElementById('config-total-area-override').value);
            if (!isNaN(inputVal) && inputVal > 0 && auth.currentUser) {
                await setDoc(settingsDocRef, { totalAreaOverride: inputVal }, { merge: true });
                showToast(`Đã cập nhật Tổng diện tích gốc thành ${formatNumber(inputVal)} m²!`, "success");
            } else {
                showToast("Vui lòng nhập giá trị hợp lệ!", "error");
            }
        }

        function loadSampleDataset(notify = true) {
            let samples = [];
            const blocks = ['A1', 'A2', 'B1', 'B2'];
            const floors = 10;
            const unitsPerFloor = 6;
            const avgArea = 69.33;

            blocks.forEach(b => {
                for (let f = 1; f <= floors; f++) {
                    for (let u = 1; u <= unitsPerFloor; u++) {
                        const floorStr = f < 10 ? `0${f}` : `${f}`;
                        const unitStr = u < 10 ? `0${u}` : `${u}`;
                        const code = `${b}-${floorStr}${unitStr}`;
                        const area = parseFloat((avgArea + ((u % 3) * 4.5) - 2.5).toFixed(2));
                        
                        samples.push({ id: code, area: area, attended: false });
                    }
                }
            });

            saveBatchApartmentsToCloud(samples, true);
            if (notify) showToast("Đã nạp dữ liệu mẫu lên Cloud!", "success");
        }

        function formatNumber(val) {
            return new Intl.NumberFormat('vi-VN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(val || 0);
        }

        function showToast(message, type = "success") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.innerText = message;
            if (type === "success") {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-base";
            } else if (type === "error") {
                toastIcon.className = "fa-solid fa-triangle-exclamation text-rose-400 text-base";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-blue-400 text-base";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        // Attach function handlers to window object for HTML inline events
        window.triggerManualConfetti = triggerCelebrationConfetti;
        window.openAdminModal = openAdminModal;
        window.closeAdminModal = closeAdminModal;
        window.handleAdminLogin = handleAdminLogin;
        window.switchAdminTab = switchAdminTab;
        window.handleFileUpload = handleFileUpload;
        window.handlePasteImport = handlePasteImport;
        window.executeQuickAttendance = executeQuickAttendance;
        window.toggleAttendance = toggleAttendance;
        window.deleteApartment = deleteApartment;
        window.requestClearAllData = requestClearAllData;
        window.closeConfirmModal = closeConfirmModal;
        window.executeClearAllData = executeClearAllData;
        window.saveTotalAreaOverride = saveTotalAreaOverride;
        window.loadSampleDataset = loadSampleDataset;
        window.renderTable = renderTable;

        // Initialize Firebase on DOM load
        window.addEventListener('DOMContentLoaded', initFirebaseAndSync);
    </script>
</body>
</html>
